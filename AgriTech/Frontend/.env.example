# Base URL API backend.
# Mode pengembangan: biarkan "/api" (diteruskan oleh proxy Vite ke VITE_DEV_PROXY_TARGET).
# Produksi: isi URL lengkap, mis. https://api.domainanda.com/api
VITE_API_BASE_URL=/api

# Target proxy Vite saat `npm run dev`
VITE_DEV_PROXY_TARGET=http://localhost:5001

# Catatan: JANGAN menaruh API key rahasia (mis. OpenWeatherMap) di sini.
# Semua variabel VITE_* akan terlihat di browser. Kunci cuaca disimpan di backend.

