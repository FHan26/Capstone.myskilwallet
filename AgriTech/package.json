{
  "name": "agritech",
  "version": "1.0.0",
  "private": true,
  "description": "AgriTech — Empowering Farmers Through Digital Technology",
  "scripts": {
    "install:all": "npm install && npm run install:backend && npm run install:frontend",
    "install:backend": "npm install --prefix Backend",
    "install:frontend": "npm install --prefix Frontend",
    "dev:backend": "npm run dev --prefix Backend",
    "dev:backend:memory": "npm run dev:memory --prefix Backend",
    "dev:frontend": "npm run dev --prefix Frontend",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:memory": "concurrently -n \"BACKEND_MEM,FRONTEND\" -c \"magenta,green\" \"npm run dev:backend:memory\" \"npm run dev:frontend\"",
    "build:frontend": "npm run build --prefix Frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}

