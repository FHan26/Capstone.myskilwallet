# ============================================
# AgriTech Backend - contoh konfigurasi
# Salin menjadi .env lalu isi nilainya.
# JANGAN commit file .env ke repository.
# ============================================

# Port server API
PORT=5001
NODE_ENV=development

# URL koneksi MongoDB (lokal atau MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/agritech

# Secret JWT: gunakan string acak yang panjang (min. 32 karakter)
# Contoh membuat: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti_dengan_string_acak_yang_panjang
JWT_EXPIRES_IN=1d

# Origin frontend yang diizinkan (pisahkan dengan koma bila lebih dari satu)
CLIENT_URL=


# true = akun petani baru harus disetujui admin sebelum dapat login
REQUIRE_ADMIN_APPROVAL=false

# API key OpenWeatherMap (https://home.openweathermap.org/api_keys)
OPENWEATHER_API_KEY=your_api_key_here

# Opsional: dipakai oleh `npm run create-admin` (bila kosong, akan ditanyakan interaktif)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

